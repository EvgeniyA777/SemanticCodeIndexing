{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semidx.example/contracts/schemas/state-invariants.schema.json",
  "title": "State Invariant Packet",
  "description": "Additive, versioned plans/016 Slice-1 state-invariant packet embedded in the impact_analysis hint map for state/lifecycle/persistence queries. Field-level write and preservation facts are deliberately absent; the guardrail directs whole-file reads instead.",
  "type": "object",
  "required": [
    "packet_version",
    "triggered_by",
    "entity_candidates",
    "state_writers",
    "assertion_tests",
    "fixture_helpers",
    "guardrail"
  ],
  "additionalProperties": false,
  "$defs": {
    "unitRef": {
      "type": "object",
      "required": ["unit_id"],
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "$ref": "common.schema.json#/$defs/boundedString"
        },
        "path": {
          "$ref": "common.schema.json#/$defs/boundedString"
        },
        "symbol": {
          "$ref": "common.schema.json#/$defs/boundedString"
        }
      }
    },
    "unitRefArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unitRef"
      },
      "maxItems": 12,
      "default": []
    },
    "entityFieldsArray": {
      "type": "array",
      "maxItems": 12,
      "default": [],
      "items": {
        "type": "object",
        "required": ["entity", "fields"],
        "additionalProperties": false,
        "properties": {
          "entity": {
            "$ref": "common.schema.json#/$defs/boundedString"
          },
          "path": {
            "$ref": "common.schema.json#/$defs/boundedString"
          },
          "fields": {
            "type": "array",
            "maxItems": 24,
            "default": [],
            "items": {
              "type": "object",
              "required": ["name"],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "$ref": "common.schema.json#/$defs/boundedString"
                },
                "nullable": {
                  "type": "boolean"
                },
                "annotations": {
                  "$ref": "common.schema.json#/$defs/stringArray"
                },
                "state_bearing": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "fieldWritesArray": {
      "type": "array",
      "maxItems": 12,
      "default": [],
      "items": {
        "type": "object",
        "required": ["unit_id", "writes"],
        "additionalProperties": false,
        "properties": {
          "unit_id": {
            "$ref": "common.schema.json#/$defs/boundedString"
          },
          "symbol": {
            "$ref": "common.schema.json#/$defs/boundedString"
          },
          "writes": {
            "type": "array",
            "maxItems": 24,
            "default": [],
            "items": {
              "$ref": "common.schema.json#/$defs/boundedString"
            }
          }
        }
      }
    }
  },
  "properties": {
    "packet_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Independent packet version enabling additive evolution once relation-backed facts land.",
      "examples": ["1.0"]
    },
    "triggered_by": {
      "$ref": "common.schema.json#/$defs/codeArray"
    },
    "entity_candidates": {
      "$ref": "#/$defs/unitRefArray"
    },
    "entity_fields": {
      "$ref": "#/$defs/entityFieldsArray"
    },
    "state_writers": {
      "$ref": "#/$defs/unitRefArray"
    },
    "field_writes": {
      "$ref": "#/$defs/fieldWritesArray"
    },
    "assertion_tests": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/boundedString"
      },
      "maxItems": 12,
      "default": []
    },
    "fixture_helpers": {
      "$ref": "#/$defs/unitRefArray"
    },
    "guardrail": {
      "type": "object",
      "required": ["code", "recommendation"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "common.schema.json#/$defs/code"
        },
        "recommendation": {
          "$ref": "common.schema.json#/$defs/boundedLongString"
        }
      }
    }
  }
}
